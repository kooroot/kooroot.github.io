---
import { icons } from './icons/index';
import { styleFor } from '../lib/categories';

interface Props {
  title: string;
  description: string;
  href: string;
  tech_stack: string[];
  github?: string;
  dune?: string;
  repo_private?: boolean;
  category: string;
}

const { title, description, href, tech_stack, github, dune, repo_private, category } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group block bg-card border border-border rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl',
    styleFor(category).cardHover,
  ]}
>
  <h3 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-accent transition-colors">
    {title}
  </h3>
  <p class="text-text-secondary text-sm leading-relaxed mb-4 line-clamp-2">
    {description}
  </p>
  <div class="flex flex-wrap gap-2 mb-4">
    {tech_stack.map((tech) => (
      <span class="px-2.5 py-1 bg-secondary border border-border rounded-md text-xs font-medium text-text-muted">
        {tech}
      </span>
    ))}
  </div>
  {(github || dune || repo_private) && (
    <div class="flex items-center gap-3 text-text-muted text-xs">
      {github && (
        <div class="flex items-center gap-1.5">
          <span set:html={icons.github} />
          <span>GitHub</span>
        </div>
      )}
      <!-- Deliberately not a link and deliberately not styled like one: the point
           is to account for the missing repo, not to invite a click that 404s. -->
      {repo_private && !github && (
        <div class="flex items-center gap-1.5">
          <span set:html={icons.lock} />
          <span>Private repo</span>
        </div>
      )}
      {dune && (
        <div class="flex items-center gap-1.5">
          <span set:html={icons.dune} />
          <span>Dune</span>
        </div>
      )}
    </div>
  )}
</a>
