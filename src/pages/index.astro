---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { icons } from '../components/icons/index';

/**
 * The three front-page slots, named and ordered.
 *
 * Two attempts at deriving them both failed the same way. Sorting all of them
 * by date handed the page to whatever shipped last — two of three slots went to
 * game projects, 2 of 59 entries. Narrowing to the relevant categories held up
 * only until three hackathon projects landed on one date, at which point an
 * arbitrary tiebreak among equals picked the front page again.
 *
 * A portfolio's best three are a judgement, not a query. These cover EVM agent
 * payments, a Solana program settling on cryptographic proof, and Rust systems
 * work — one axis each, no overlap.
 */
const FEATURED_SLUGS = ['mapae', 'proofmarket', 'nerve'] as const;

const allProjects = await getCollection('projects');
const byId = new Map(allProjects.map((p) => [p.id, p]));

// Loudly, at build time: a renamed or deleted file must not silently shrink the
// front page to two cards.
const featuredProjects = FEATURED_SLUGS.map((slug) => {
  const project = byId.get(slug);
  if (!project) throw new Error(`Featured project "${slug}" has no entry in src/content/projects/`);
  return project;
});
---

<BaseLayout>
  <Hero />

  <!-- Featured Projects -->
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl md:text-3xl font-bold text-text-primary">Featured Projects</h2>
      <a href="/projects" class="text-accent text-sm hover:underline flex items-center gap-1">
        View all
        <span set:html={icons.arrow} />
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          href={`/projects/${project.id}`}
          tech_stack={project.data.tech_stack}
          github={project.data.github}
          dune={project.data.dune}
          repo_private={project.data.repo_private}
          category={project.data.category}
        />
      ))}
    </div>
  </section>

  <!-- About Preview -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <div class="bg-secondary border border-border rounded-2xl p-8 md:p-12 fade-in-up">
      <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-4">About Me</h2>
      <p class="text-text-secondary leading-relaxed mb-6 max-w-2xl">
        Five years across Ethereum L2, smart contract security, and node infrastructure, with most recent work on AI agent systems.
        From smart contract auditing to on-chain analytics and ML-based prediction systems.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/about" class="px-5 py-2.5 bg-accent-strong text-white rounded-lg text-sm font-medium hover:bg-[#1d4ed8] transition-colors flex items-center gap-2">
          Learn More
          <span set:html={icons.arrow} />
        </a>
        <a href="https://github.com/kooroot" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-card border border-border text-text-primary rounded-lg text-sm font-medium hover:border-accent/50 transition-colors flex items-center gap-2">
          <span set:html={icons.github} />
          GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
