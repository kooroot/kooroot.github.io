---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { PROJECT_CATEGORIES } from '../lib/categories';
import { icons } from '../components/icons/index';

const allProjects = await getCollection('projects');

// Array order is section order on this page. The dropped `icon` key on each
// category was never read — nothing on this page renders a category icon.
const sections = PROJECT_CATEGORIES.map((cat) => ({
  cat,
  projects: allProjects
    .filter((p) => p.data.category === cat.name && p.data.show_tile)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
})).filter((s) => s.projects.length > 0);
---

<BaseLayout title="Projects" description="Blockchain Research & Development Projects">
  <!-- Banner -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-secondary/50 to-transparent" />
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">Projects</h1>
      <p class="text-text-secondary text-lg max-w-2xl">
        DeFi protocols, prediction market systems, smart contract audits, on-chain analytics, and distributed node infrastructure — built across Ethereum, Solana, and multiple L2 networks.
      </p>
    </div>
  </section>

  <!-- Project Categories -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    {sections.map(({ cat, projects }) => (
      <div class="mb-16 fade-in-up">
        <h2 class={`text-2xl font-bold mb-8 pb-4 border-b border-border flex items-center gap-3 ${cat.heading}`}>
          {cat.name}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              href={`/projects/${project.id}`}
              tech_stack={project.data.tech_stack}
              github={project.data.github}
              dune={project.data.dune}
              repo_private={project.data.repo_private}
              category={project.data.category}
            />
          ))}
        </div>
      </div>
    ))}

    <!-- Research Focus -->
    <div class="mt-16 p-8 bg-secondary border border-border rounded-2xl fade-in-up">
      <h2 class="text-2xl font-bold text-text-primary mb-4">Research Focus & Future Direction</h2>
      <p class="text-text-secondary leading-relaxed mb-6">
        Currently focused on the intersection of prediction markets and on-chain data — building ML pipelines for market signals, DeFi trading automation, and cross-chain interoperability. Continuing research in L2 rollup optimization and smart contract security.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/about" class="px-5 py-2.5 bg-accent-strong text-white rounded-lg text-sm font-medium hover:bg-[#1d4ed8] transition-colors">
          About Me
        </a>
        <a href="https://github.com/kooroot" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-card border border-border text-text-primary rounded-lg text-sm font-medium hover:border-accent/50 transition-colors flex items-center gap-2 [&_svg]:h-4 [&_svg]:w-4">
          <span set:html={icons.github} aria-hidden="true" />
          GitHub
        </a>
        <a href="https://x.com/k00r00t" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 bg-card border border-border text-text-primary rounded-lg text-sm font-medium hover:border-accent/50 transition-colors flex items-center gap-2 [&_svg]:h-4 [&_svg]:w-4">
          <span set:html={icons.twitter} aria-hidden="true" />
          @k00r00t
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
