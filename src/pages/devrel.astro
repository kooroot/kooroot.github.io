---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { byDateDesc, hrefOf, isExternal, toCards } from '../lib/writing';
import { icons } from '../components/icons/index';
import { SITE } from '../consts';

// Reads the same content collections as the rest of the site. The Telegram
// channel, the two Mapae links and the contact row are the hardcoded parts.
const projects = await getCollection('projects');
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (slugs) => slugs.map((s) => byId.get(s)).filter(Boolean);

// Oldest network first.
const nodeExecutors = pick([
  'ritual-node-executor',
  'node-nexus',
  'node-gensyn',
  'privasea-node-executor',
  'node-hyperlane',
  'node-pipenetwork',
  'node-gaianet',
  'node-soundness',
]);

const [flagship, ...supporting] = pick(['mapae', 'nerve', 'engram']);
const localization = byId.get('claude-learn-ko');

// Affiliation is carried per item rather than on the section: the CTF was made
// with the Graylab team the year before joining them, and the localization was
// independent.
const ctf = byId.get('ethcon2024-ctf');

// This year's run, oldest first. The count and the month span in the colophon are
// read off these entries, so neither can drift away from the dates on the cards.
const recent = pick(['claude-learn-ko', 'engram', 'nerve', 'mapae']).sort(
  (a, b) => a.data.date - b.data.date,
);
const firstRelease = recent[0].data.date;
const lastRelease = recent[recent.length - 1].data.date;
const releaseSpanEn = `${firstRelease.toLocaleDateString('en-US', { month: 'short' })}–${lastRelease.toLocaleDateString('en-US', { month: 'short' })} ${lastRelease.getFullYear()}`;
const releaseSpanKo = `${lastRelease.getFullYear()}년 ${firstRelease.getMonth() + 1}–${lastRelease.getMonth() + 1}월`;
const releaseNames = recent.map((p) => p.data.title).join(', ');

// Live sites for the flagship: the product and the documentation that ships with it.
const FLAGSHIP_LINKS = [
  { label: 'mapae.io', href: 'https://mapae.io', note: 'product', note_ko: '제품' },
  {
    label: 'docs.mapae.io',
    href: 'https://docs.mapae.io',
    note: 'docs, runbooks, error model',
    note_ko: '문서 · 런북 · 에러 모델',
  },
];

const projectTitles = new Map(projects.map((p) => [p.id, p.data.title]));

const writing = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort(byDateDesc);
const writingCards = toCards(writing);

// Derived rather than asserted: every figure below is whatever the collection
// actually holds, so none of them can drift out of step with the sections that
// display the underlying entries.
const networkCount = nodeExecutors.length;
const bilingualCount = writingCards.filter((c) => c.versions.length > 1).length;
// Naming a single venue next to the total count would credit one publisher with
// pieces published elsewhere, so the venues are listed from the data too.
const venues = [...new Set(writing.map((p) => p.data.publication).filter(Boolean))].sort();

// Every executor lists "Shell" first, so tech_stack[0] would render the same
// word eight times. Skip the shared substrate and surface what differs.
const SUBSTRATE = new Set(['Shell', 'Linux', 'Docker']);
const distinguishingTech = (p) =>
  p.data.tech_stack.find((t) => !SUBSTRATE.has(t)) ?? p.data.tech_stack[0];

// The series name is the section's subject; repeating it in all eight rows is noise.
const networkName = (p) => p.data.title.replace(/\s+Node Executor$/, '');

// Korean copy exists for the three entries this page leads with; everything else
// falls back to the published English rather than showing a blank.
const describe = (p) => p.data.description_ko ?? p.data.description;

// Dated because it goes stale: the previous hardcoded 6,762 had already been
// overtaken by the time anyone noticed.
const TELEGRAM = {
  url: 'https://t.me/web3_laborer',
  handle: 't.me/web3_laborer',
  name: '이것저것 다하는 방',
  subscribers: '6,767',
  asOf: 'Aug 2026',
  asOfKo: '2026년 8월',
};

// Contact channels, in the order a reader would actually use them. Each href was
// checked from a signed-out client and resolves to real content.
//
// LinkedIn is absent from this row on purpose: it answers every logged-out
// request with an auth wall, so there is no way to confirm from outside that the
// URL lands on a real profile. It stays in the CV, where the reader is a
// recruiter who is already signed in. (The site footer still carries it via
// SOCIALS — a sitewide choice, not this page's to quietly reverse.)
const CONTACTS = [
  { icon: 'telegram', label: 'Telegram — 이것저것 다하는 방', href: TELEGRAM.url },
  { icon: 'github', label: 'GitHub — kooroot', href: 'https://github.com/kooroot' },
  { icon: 'twitter', label: 'X — @k00r00t', href: 'https://x.com/k00r00t' },
  { icon: 'linktree', label: 'Linktree — kooroot', href: 'https://linktr.ee/kooroot' },
];

// Five writing entries were reconstructed from a listing that recorded only year
// and month; their files declare date_precision: "month" and their day is a
// placeholder. Printing "Jun 1, 2025" for those would invent a precision the
// source itself disclaims, so the day is dropped from both the visible text and
// the datetime attribute rather than being asserted to a machine.
const byMonth = (e) => e.data.date_precision === 'month';
const fmt = (e) =>
  e.data.date.toLocaleDateString('en-US',
    byMonth(e) ? { year: 'numeric', month: 'short' }
               : { year: 'numeric', month: 'short', day: 'numeric' });
const fmtKo = (e) =>
  e.data.date.toLocaleDateString('ko-KR',
    byMonth(e) ? { year: 'numeric', month: 'short' }
               : { year: 'numeric', month: 'short', day: 'numeric' });
// <time> needs a machine-readable value; the visible text is not a valid datetime.
// YYYY-MM is a valid datetime in its own right, so a month-precision entry stays
// machine-readable without claiming a day.
const iso = (e) => e.data.date.toISOString().slice(0, byMonth(e) ? 7 : 10);
---

<BaseLayout
  title="Developer Relations"
  description="Node install tooling for eight networks, bilingual technical writing for an L2 protocol company, and agent payment infrastructure on GIWA Sepolia."
>
  <!--
    Language state, set before first paint so a returning Korean reader never
    sees the English flash. Both languages are in the DOM; CSS decides which one
    is displayed. `display: none` also removes the inactive copy from the
    accessibility tree, so a screen reader is never read both.
  -->
  <script is:inline>
    (function () {
      var saved = null;
      try {
        saved = localStorage.getItem('devrel-lang');
      } catch (e) {
        /* private mode, or storage disabled — fall through to the browser hint */
      }
      var lang =
        saved === 'ko' || saved === 'en'
          ? saved
          : (navigator.language || '').toLowerCase().indexOf('ko') === 0
            ? 'ko'
            : 'en';
      document.documentElement.setAttribute('data-lang', lang);
      document.documentElement.lang = lang;
    })();
  </script>

  <!-- ── Masthead ─────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_15%_0%,rgba(59,130,246,0.10),transparent_55%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 pt-16 pb-12 md:pt-24 md:pb-14">
      <!--
        The toggle sits in the page rather than in a second top bar, because the
        site already has one nav and a page-local control that looks like chrome
        would be lying about its scope: this switches this page, not the site.
        Hidden until Head.astro sets `.js`, so it is never drawn dead.
      -->
      <div class="rise flex items-center justify-between gap-4 mb-8" style="--d:0ms">
        <p class="font-mono text-[11px] tracking-wider text-text-muted uppercase">
          <span data-en>Developer Relations · Seoul · EN / KO</span>
          <span data-ko>Developer Relations · Seoul · 국문 / 영문</span>
        </p>
        <button
          id="lang-toggle"
          type="button"
          class="shrink-0 items-center gap-2 rounded-full border border-border bg-secondary/60 px-3.5 py-1.5 font-mono text-xs text-text-secondary transition-colors hover:border-accent/60 hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span aria-hidden="true">⇄</span>
          <span id="lang-toggle-label">한국어</span>
        </button>
      </div>

      <h1 class="rise hero-title font-bold text-text-primary" style="--d:60ms">
        <span data-en>
          Docs that get a first-timer to
          <span class="text-accent">a running node</span>.
        </span>
        <span data-ko>
          처음 해보는 사람이 <span class="text-accent">노드를 띄우게</span> 만드는 문서.
        </span>
      </h1>

      <p class="rise mt-7 text-text-secondary text-lg leading-relaxed max-w-[64ch]" style="--d:150ms">
        <span data-en>
          At an L2 protocol company, the rollup we ran was posting a net loss. I worked out how far
          the transaction and state-root submission intervals could widen before the security
          assumptions break. It went into production and the cost came down, and I published the
          analysis in Korean and English. I run a Korean developer channel where the node
          walkthroughs go out with install scripts a reader can run. And I keep building. Four
          releases since March, and I wrote the docs for all four.
        </span>
        <span data-ko>
          L2 프로토콜 회사에 있을 때 우리가 운영하던 롤업이 순손실을 내고 있었다. 보안 가정이 깨지기
          전까지 트랜잭션과 스테이트루트 제출 주기를 얼마나 늘릴 수 있는지 분석했고, 실제 운영에
          반영돼 비용이 내려갔다. 분석 내용은 국문과 영문으로 발행했다. 한국어 개발자 채널도
          운영한다. 노드 운영 글에는 독자가 그대로 돌려볼 수 있는 설치 스크립트를 같이 올린다.
          그리고 계속 만든다. 3월 이후로 네 개를 냈고, 문서는 전부 직접 썼다.
        </span>
      </p>

      <!-- Five rows, each traceable to a section further down the page. -->
      <dl class="rise mt-12 max-w-[52rem] border-t border-border" style="--d:240ms">
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">
            <span data-en>Channel</span><span data-ko>채널</span>
          </dt>
          <dd class="text-sm text-text-secondary">
            <span lang="ko" class="text-text-primary">{TELEGRAM.name}</span>
            <span data-en>— {TELEGRAM.subscribers} members as of {TELEGRAM.asOf}, sole operator</span>
            <span data-ko>— {TELEGRAM.asOfKo} 기준 {TELEGRAM.subscribers}명, 단독 운영</span>
          </dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">
            <span data-en>Tooling</span><span data-ko>도구</span>
          </dt>
          <dd class="text-sm text-text-secondary">
            <span data-en>
              <span class="text-text-primary">{networkCount} networks</span>
              — one install script each, Linux and macOS
            </span>
            <span data-ko>
              <span class="text-text-primary">{networkCount}개 네트워크</span>
              — 각각 설치 스크립트 하나, Linux·macOS 지원
            </span>
          </dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">
            <span data-en>Published</span><span data-ko>발행</span>
          </dt>
          <dd class="text-sm text-text-secondary">
            <span class="text-text-primary">{venues.join(' · ')}</span>
            <span data-en>
              — {writingCards.length} pieces, {bilingualCount} of them published in both languages
            </span>
            <span data-ko>
              — {writingCards.length}편, 그중 {bilingualCount}편은 국문·영문 양쪽으로 발행
            </span>
          </dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">
            <span data-en>Material</span><span data-ko>자료</span>
          </dt>
          <dd class="text-sm text-text-secondary">
            <span data-en>
              <span class="text-text-primary">CTF and curriculum</span>
              — challenges for EthCon Korea 2024, 388 Anthropic Academy lessons in Korean
            </span>
            <span data-ko>
              <span class="text-text-primary">CTF와 커리큘럼</span>
              — EthCon Korea 2024 문제 출제, Anthropic Academy 388개 레슨 한국어판
            </span>
          </dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">
            <span data-en>Released</span><span data-ko>릴리스</span>
          </dt>
          <dd class="text-sm text-text-secondary">
            <span data-en>
              <span class="text-text-primary">{releaseSpanEn}</span>
              — {releaseNames}
            </span>
            <span data-ko>
              <span class="text-text-primary">{releaseSpanKo}</span>
              — {releaseNames}
            </span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ── The loop ─────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-16 md:py-20">
    <h2 class="text-2xl md:text-3xl font-bold text-text-primary">
      <span data-en>Channel, tooling, writing</span><span data-ko>채널, 도구, 글</span>
    </h2>

    <ol class="mt-10">
      <!-- ask -->
      <li class="grid md:grid-cols-[4.5rem_1fr] gap-x-8">
        <div class="mb-4 md:mb-0 md:pt-1 md:text-right">
          <span class="font-mono text-xs text-accent">
            <span data-en>ask</span><span data-ko>질문</span>
          </span>
        </div>
        <div class="relative md:border-l md:border-border md:pl-9 pb-12 md:pb-14">
          <span
            class="hidden md:block absolute -left-[3.5px] top-2 w-[7px] h-[7px] rounded-full bg-accent"
            aria-hidden="true"></span>

          <a
            href={TELEGRAM.url}
            target="_blank"
            rel="noopener noreferrer"
            class="lift group block rounded-2xl border border-accent/25 bg-card p-6 md:p-7 hover:border-accent/60"
          >
            <div class="flex items-center gap-2.5 font-mono text-[11px] text-text-muted mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" aria-hidden="true"></span>
              {TELEGRAM.handle}
            </div>
            <h3
              lang="ko"
              class="text-xl md:text-2xl font-semibold text-text-primary group-hover:text-accent transition-colors"
            >
              {TELEGRAM.name}
            </h3>
            <p class="mt-3 text-text-secondary leading-relaxed max-w-[58ch]">
              <span data-en>
                Node walkthroughs, protocol breakdowns and tooling notes, in Korean. A good part of
                the readership are not developers, so the walkthroughs go out with the scripts and
                I answer what comes back. These days it is mostly on-chain research and security links.
              </span>
              <span data-ko>
                노드 운영 워크스루, 프로토콜 해설, 툴링 노트를 한국어로 올린다. 읽는 사람 중 상당수는
                개발자가 아니라서, 글에는 항상 스크립트를 같이 붙이고 올라오는 질문에 직접 답한다.
                지금은 온체인 리서치와 보안 큐레이션 쪽으로 이어가고 있다.
              </span>
            </p>
            <span class="inline-block mt-5 text-sm text-accent">
              <span data-en>Open the channel</span><span data-ko>채널 열기</span>
              <span aria-hidden="true">&#8599;</span>
            </span>
          </a>
        </div>
      </li>

      <!-- ship -->
      <li class="grid md:grid-cols-[4.5rem_1fr] gap-x-8">
        <div class="mb-4 md:mb-0 md:pt-1 md:text-right">
          <span class="font-mono text-xs text-accent">
            <span data-en>ship</span><span data-ko>배포</span>
          </span>
        </div>
        <div class="relative md:border-l md:border-border md:pl-9 pb-12 md:pb-14">
          <span
            class="hidden md:block absolute -left-[3.5px] top-2 w-[7px] h-[7px] rounded-full bg-accent"
            aria-hidden="true"></span>

          <h3 class="text-xl md:text-2xl font-semibold text-text-primary">
            <span data-en>Node Executor series</span><span data-ko>Node Executor 시리즈</span>
          </h3>
          <p class="mt-3 text-text-secondary leading-relaxed max-w-[60ch]">
            <span data-en>
              Plenty of people wanted to run a node for the rewards and stalled on the setup, and
              most of them were not developers. I had been running validators already, so I moved
              what I knew into scripts: OS and GPU detection, dependency install, session
              management, config patching, on both Linux and macOS.
            </span>
            <span data-ko>
              보상을 받으려고 노드를 돌려보다 셋업에서 막히는 사람이 많았고, 그중 대부분은 개발자가
              아니었다. 나는 이미 밸리데이터를 운영하고 있었으니 알던 것을 스크립트로 옮겼다. OS·GPU
              감지, 의존성 설치, 세션 관리, 설정 파일 패칭까지 넣었고 Linux와 macOS 양쪽에서
              돌아간다.
            </span>
          </p>

          <ul class="mt-7 grid sm:grid-cols-2 gap-x-10 border-t border-border">
            {nodeExecutors.map((p) => (
              <li class="border-b border-border">
                <a
                  href={`/projects/${p.id}`}
                  class="group flex items-baseline justify-between gap-4 py-3 transition-colors"
                >
                  <span class="text-sm text-text-secondary group-hover:text-accent transition-colors">
                    {networkName(p)}
                  </span>
                  <span class="font-mono text-[11px] text-text-muted whitespace-nowrap">
                    {distinguishingTech(p)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      <!-- publish -->
      <li class="grid md:grid-cols-[4.5rem_1fr] gap-x-8">
        <div class="mb-4 md:mb-0 md:pt-1 md:text-right">
          <span class="font-mono text-xs text-accent">
            <span data-en>publish</span><span data-ko>발행</span>
          </span>
        </div>
        <div class="relative md:border-l md:border-border md:pl-9">
          <span
            class="hidden md:block absolute -left-[3.5px] top-2 w-[7px] h-[7px] rounded-full bg-accent"
            aria-hidden="true"></span>

          <h3 class="text-xl md:text-2xl font-semibold text-text-primary">
            <span data-en>Writing</span><span data-ko>글</span>
          </h3>
          <!-- Titles and descriptions below come from the writing collection and stay in the
               language each piece was published in. Restating a published title in the other
               language would name an article that does not exist under that name. -->
          <ul class="mt-7 border-t border-border">
            {writingCards.map(({ lead, versions }) => (
              <li class="border-b border-border py-5">
                <div class="flex items-baseline justify-between gap-4 mb-2">
                  <div class="flex flex-wrap items-center gap-2 min-w-0">
                    {lead.data.publication && (
                      <span class="font-mono text-[11px] text-accent">{lead.data.publication}</span>
                    )}
                    {versions.length > 1 && (
                      <span class="font-mono text-[11px] text-text-muted uppercase">
                        · {versions.map((v) => v.data.lang).join(' + ')}
                      </span>
                    )}
                  </div>
                  <time
                    datetime={iso(lead)}
                    class="font-mono text-[11px] text-text-muted whitespace-nowrap"
                  >
                    <span data-en>{fmt(lead)}</span>
                    <span data-ko>{fmtKo(lead)}</span>
                  </time>
                </div>

                {versions.length > 1 ? (
                  <h4 lang={lead.data.lang} class="text-base font-semibold text-text-primary">
                    {lead.data.title}
                  </h4>
                ) : (
                  <a
                    href={hrefOf(lead)}
                    target={isExternal(lead) ? '_blank' : undefined}
                    rel={isExternal(lead) ? 'noopener noreferrer' : undefined}
                    class="group inline-block"
                  >
                    <h4
                      lang={lead.data.lang}
                      class="text-base font-semibold text-text-primary group-hover:text-accent transition-colors"
                    >
                      {lead.data.title}
                      {isExternal(lead) && (
                        <span class="text-text-muted group-hover:text-accent ml-1.5 text-sm" aria-hidden="true">
                          &#8599;
                        </span>
                      )}
                    </h4>
                  </a>
                )}

                <p
                  lang={lead.data.lang}
                  class="mt-2 text-sm text-text-secondary leading-relaxed max-w-[62ch]"
                >
                  {lead.data.description}
                </p>

                <!-- The heading above is plain text for paired entries, so these chips are the
                     only links to the piece; "EN" alone is not an accessible name. -->
                {versions.length > 1 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {versions.map((v) => (
                      <a
                        href={hrefOf(v)}
                        target={isExternal(v) ? '_blank' : undefined}
                        rel={isExternal(v) ? 'noopener noreferrer' : undefined}
                        aria-label={`${v.data.title} (${v.data.lang.toUpperCase()})`}
                        class="inline-flex items-center gap-2 rounded-lg border border-border px-2.5 py-1.5 text-xs text-text-secondary hover:border-accent/60 hover:text-accent transition-colors"
                      >
                        <span class="font-mono uppercase text-[10px] text-accent">{v.data.lang}</span>
                        {v.data.read_time && <span class="text-text-muted">{v.data.read_time}</span>}
                        {isExternal(v) && <span aria-hidden="true">&#8599;</span>}
                      </a>
                    ))}
                  </div>
                )}

