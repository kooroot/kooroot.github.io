<style>
  .hero-title {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /*
    Language swap. Only the *inactive* copy carries a display rule, so the active
    one keeps whatever display its own classes give it — writing `display: revert`
    on the visible side would flatten every `flex` and `grid` back to `block`.
    With no JS the html element has no data-lang, the :not() matches, and the
    page renders as English rather than as both languages at once.
  */
  :global(html:not([data-lang='ko'])) [data-ko] {
    display: none;
  }

  :global(html[data-lang='ko']) [data-en] {
    display: none;
  }

  /* A control that cannot work should not be drawn. `.js` is set in Head.astro
     before first paint, so this never flashes. */
  #lang-toggle {
    display: none;
  }

  :global(html.js) #lang-toggle {
    display: inline-flex;
  }

  /* A single page-load orchestration on the masthead. Deliberately not repeated
     per section — and driven by CSS rather than an observer class, so the content
     is present even when the animation never runs. */
  .rise {
    animation: rise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .lift {
    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 250ms ease-out;
  }

  .lift:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
    .lift {
      transition: border-color 250ms ease-out;
    }
    .lift:hover {
      transform: none;
    }
    /* Tailwind's animate-pulse carries no reduced-motion guard of its own. */
    :global(.animate-pulse) {
      animation: none;
    }
  }
</style>
