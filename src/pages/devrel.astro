  <script>
    // The button announces the language it switches *to*, which is why it reads
    // "한국어" while the page is in English.
    const html = document.documentElement;
    const btn = document.getElementById('lang-toggle');
    const label = document.getElementById('lang-toggle-label');

    const LABEL = { en: '한국어', ko: 'English' };
    const ARIA = { en: '한국어로 보기', ko: 'View in English' };

    function render(lang: 'en' | 'ko') {
      html.setAttribute('data-lang', lang);
      html.lang = lang;
      if (label) label.textContent = LABEL[lang];
      btn?.setAttribute('aria-label', ARIA[lang]);
    }

    // Only an explicit click is persisted. Writing the browser-language guess to
    // storage would freeze a default the reader never chose.
    function choose(lang: 'en' | 'ko') {
      render(lang);
      try {
        localStorage.setItem('devrel-lang', lang);
      } catch {
        /* storage unavailable — the choice still applies for this page view */
      }
    }

    render(html.getAttribute('data-lang') === 'ko' ? 'ko' : 'en');
    btn?.addEventListener('click', () =>
      choose(html.getAttribute('data-lang') === 'ko' ? 'en' : 'ko'),
    );
  </script>
