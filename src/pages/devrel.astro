---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { byDateDesc, hrefOf, isExternal, toCards } from '../lib/writing';
import { SITE } from '../consts';

// A focused view of the same content collections the rest of the site reads —
// nothing here is hardcoded except the Telegram channel, which is not a project.
const projects = await getCollection('projects');
const byId = new Map(projects.map((p) => [p.id, p]));
const pick = (slugs) => slugs.map((s) => byId.get(s)).filter(Boolean);

// Ordered oldest-network-first so the series reads as a run, not a pile.
const nodeExecutors = pick([
  'ritual-node-executor',
  'node-nexus',
  'node-gensyn',
  'privasea-node-executor',
  'node-hyperlane',
  'node-pipenetwork',
  'node-gaianet',
  'node-soundness',
]);

const [flagship, ...supporting] = pick(['mapae', 'nerve', 'engram']);
const localization = byId.get('claude-learn-ko');

// Developer-facing work that predates the channel. Affiliation is carried per
// item rather than on the section: the lecture series and the Tokamak Network
// pieces are both Onther-tenure work, but the CTF was run with the Graylab team
// before joining them, and collapsing the two would misstate who I did what for.
const lecture = byId.get('smartcontract-lecture');
const ctf = byId.get('ethcon2024-ctf');

// Live sites for the flagship. These are the actual work sample for a docs role —
// a reference implementation is a claim; its published documentation is the proof.
const FLAGSHIP_LINKS = [
  { label: 'mapae.io', href: 'https://mapae.io', note: 'product' },
  { label: 'docs.mapae.io', href: 'https://docs.mapae.io', note: 'docs, runbooks, error model' },
];

const projectTitles = new Map(projects.map((p) => [p.id, p.data.title]));

const writing = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort(byDateDesc);
const writingCards = toCards(writing);

// Derived rather than asserted: every figure below is whatever the collection
// actually holds, so none of them can drift out of step with the sections that
// display the underlying entries.
const networkCount = nodeExecutors.length;
const bilingualCount = writingCards.filter((c) => c.versions.length > 1).length;
// Naming a single venue next to the total count would credit one publisher with
// pieces published elsewhere, so the venues are listed from the data too.
const venues = [...new Set(writing.map((p) => p.data.publication).filter(Boolean))].sort();

// Every executor lists "Shell" first, so tech_stack[0] would render the same
// word eight times. Skip the shared substrate and surface what differs.
const SUBSTRATE = new Set(['Shell', 'Linux', 'Docker']);
const distinguishingTech = (p) =>
  p.data.tech_stack.find((t) => !SUBSTRATE.has(t)) ?? p.data.tech_stack[0];

// The series name is the section's subject; repeating it in all eight rows is noise.
const networkName = (p) => p.data.title.replace(/\s+Node Executor$/, '');

// A subscriber count is a measurement, and measurements go stale. Carrying the
// date it was taken keeps the number honest between updates instead of quietly
// drifting — the previous hardcoded 6,762 had already been overtaken.
const TELEGRAM = {
  url: 'https://t.me/web3_laborer',
  handle: 't.me/web3_laborer',
  name: '이것저것 다하는 방',
  subscribers: '6,767',
  asOf: 'Aug 2026',
};

// The byline on the Tokamak Network pieces. Linking work published under a
// different name without saying so invites the reader to doubt the citation.
const BYLINE = 'Ethan.K';

const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
// <time> needs a machine-readable value; the visible text is not a valid datetime.
const iso = (d) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title="Developer Relations"
  description="Closing the distance between the doc and the terminal — developer tooling, bilingual technical writing, and agent infrastructure."
>
  <!-- ── Masthead ─────────────────────────────────────────────── -->
  <section class="relative overflow-hidden">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_15%_0%,rgba(59,130,246,0.10),transparent_55%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 pt-16 pb-12 md:pt-24 md:pb-14">
      <h1 class="rise hero-title font-bold text-text-primary" style="--d:0ms">
        Closing the distance between<br class="hidden sm:block" />
        <span class="text-accent">the doc and the terminal</span>.
      </h1>

      <p class="rise mt-7 text-text-secondary text-lg leading-relaxed max-w-[64ch]" style="--d:90ms">
        I've worked both ends of the loop — writing the docs, and sitting with the people who run
        them. For two years at an L2 protocol company I published rollup deep-dives in Korean and
        English and taught the university course that fed builders into it; since then I've run a
        developer channel where I hear where people actually get stuck, and shipped the tooling
        they asked for. Documentation is only proven on someone else's terminal.
      </p>

      <!-- A colophon, not a stat block: three claims, each traceable to something
           further down the page. -->
      <dl class="rise mt-12 max-w-[52rem] border-t border-border" style="--d:180ms">
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">Channel</dt>
          <dd class="text-sm text-text-secondary">
            <span lang="ko" class="text-text-primary">{TELEGRAM.name}</span>
            — {TELEGRAM.subscribers} members as of {TELEGRAM.asOf}, sole operator
          </dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">Tooling</dt>
          <dd class="text-sm text-text-secondary">
            <span class="text-text-primary">{networkCount} networks</span>
            — one-command node installers, shipped from channel questions
          </dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">Published</dt>
          <dd class="text-sm text-text-secondary">
            <span class="text-text-primary">{venues.join(' · ')}</span>
            — {writingCards.length} pieces, {bilingualCount} of them rebuilt for a second language
            rather than translated
          </dd>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-[7.5rem_1fr] gap-x-6 gap-y-1 py-3.5 border-b border-border">
          <dt class="font-mono text-[11px] tracking-wider text-text-muted uppercase sm:pt-0.5">Taught</dt>
          <dd class="text-sm text-text-secondary">
            <span class="text-text-primary">A university semester, a conference CTF</span>
            — plus 388 lessons localized into Korean
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ── The loop ─────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-16 md:py-20">
    <h2 class="text-2xl md:text-3xl font-bold text-text-primary">The loop</h2>
    <p class="mt-3 text-text-secondary leading-relaxed max-w-[64ch]">
      Questions arrive in the channel. Tooling and docs go back out. What comes back gets folded in.
      Across {networkCount} networks, this is the same three steps every time.
    </p>

    <ol class="mt-10">
      <!-- ask -->
      <li class="grid md:grid-cols-[4.5rem_1fr] gap-x-8">
        <div class="mb-4 md:mb-0 md:pt-1 md:text-right">
          <span class="font-mono text-xs text-accent">ask</span>
        </div>
        <div class="relative md:border-l md:border-border md:pl-9 pb-12 md:pb-14">
          <span
            class="hidden md:block absolute -left-[3.5px] top-2 w-[7px] h-[7px] rounded-full bg-accent"
            aria-hidden="true"></span>

          <a
            href={TELEGRAM.url}
            target="_blank"
            rel="noopener noreferrer"
            class="lift group block rounded-2xl border border-accent/25 bg-card p-6 md:p-7 hover:border-accent/60"
          >
            <div class="flex items-center gap-2.5 font-mono text-[11px] text-text-muted mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" aria-hidden="true"></span>
              {TELEGRAM.handle}
            </div>
            <h3
              lang="ko"
              class="text-xl md:text-2xl font-semibold text-text-primary group-hover:text-accent transition-colors"
            >
              {TELEGRAM.name}
            </h3>
            <p class="mt-3 text-text-secondary leading-relaxed max-w-[58ch]">
              A developer community I run alone. During the node boom I built and shipped automation
              scripts here and answered whatever came back; today it runs as on-chain research and
              security curation. This is the room the rest of this page came out of.
            </p>
            <span class="inline-block mt-5 text-sm text-accent">
              Open the channel <span aria-hidden="true">&#8599;</span>
            </span>
          </a>
        </div>
      </li>

      <!-- ship -->
      <li class="grid md:grid-cols-[4.5rem_1fr] gap-x-8">
        <div class="mb-4 md:mb-0 md:pt-1 md:text-right">
          <span class="font-mono text-xs text-accent">ship</span>
        </div>
        <div class="relative md:border-l md:border-border md:pl-9 pb-12 md:pb-14">
          <span
            class="hidden md:block absolute -left-[3.5px] top-2 w-[7px] h-[7px] rounded-full bg-accent"
            aria-hidden="true"></span>

          <h3 class="text-xl md:text-2xl font-semibold text-text-primary">
            Node Executor series
          </h3>
          <p class="mt-3 text-text-secondary leading-relaxed max-w-[60ch]">
            The repeated questions, moved into tooling. OS detection, GPU detection, dependency
            install, session management, config patching — a new operator's first hour compressed
            into a handful of commands. macOS support exists because people in the channel asked
            for it.
          </p>

          <ul class="mt-7 grid sm:grid-cols-2 gap-x-10 border-t border-border">
            {nodeExecutors.map((p) => (
              <li class="border-b border-border">
                <a
                  href={`/projects/${p.id}`}
                  class="group flex items-baseline justify-between gap-4 py-3 transition-colors"
                >
                  <span class="text-sm text-text-secondary group-hover:text-accent transition-colors">
                    {networkName(p)}
                  </span>
                  <span class="font-mono text-[11px] text-text-muted whitespace-nowrap">
                    {distinguishingTech(p)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      <!-- publish -->
      <li class="grid md:grid-cols-[4.5rem_1fr] gap-x-8">
        <div class="mb-4 md:mb-0 md:pt-1 md:text-right">
          <span class="font-mono text-xs text-accent">publish</span>
        </div>
        <div class="relative md:border-l md:border-border md:pl-9">
          <span
            class="hidden md:block absolute -left-[3.5px] top-2 w-[7px] h-[7px] rounded-full bg-accent"
            aria-hidden="true"></span>

          <h3 class="text-xl md:text-2xl font-semibold text-text-primary">Writing</h3>
          <p class="mt-3 text-text-secondary leading-relaxed max-w-[60ch]">
            Most recent first. The paired entries are one piece of work rebuilt for a second
            audience — restructured, not translated. The Tokamak Network pieces are bylined
            <span class="text-text-primary">{BYLINE}</span>, the name I worked under at Onther.
          </p>

          <ul class="mt-7 border-t border-border">
            {writingCards.map(({ lead, versions }) => (
              <li class="border-b border-border py-5">
                <div class="flex items-baseline justify-between gap-4 mb-2">
                  <div class="flex flex-wrap items-center gap-2 min-w-0">
                    {lead.data.publication && (
                      <span class="font-mono text-[11px] text-accent">{lead.data.publication}</span>
                    )}
                    {versions.length > 1 && (
                      <span class="font-mono text-[11px] text-text-muted uppercase">
                        · {versions.map((v) => v.data.lang).join(' + ')}
                      </span>
                    )}
                  </div>
                  <time
                    datetime={iso(lead.data.date)}
                    class="font-mono text-[11px] text-text-muted whitespace-nowrap"
                  >
                    {fmt(lead.data.date)}
                  </time>
                </div>

                {versions.length > 1 ? (
                  <h4 lang={lead.data.lang} class="text-base font-semibold text-text-primary">
                    {lead.data.title}
                  </h4>
                ) : (
                  <a
                    href={hrefOf(lead)}
                    target={isExternal(lead) ? '_blank' : undefined}
                    rel={isExternal(lead) ? 'noopener noreferrer' : undefined}
                    class="group inline-block"
                  >
                    <h4
                      lang={lead.data.lang}
                      class="text-base font-semibold text-text-primary group-hover:text-accent transition-colors"
                    >
                      {lead.data.title}
                      {isExternal(lead) && (
                        <span class="text-text-muted group-hover:text-accent ml-1.5 text-sm" aria-hidden="true">
                          &#8599;
                        </span>
                      )}
                    </h4>
                  </a>
                )}

                <p
                  lang={lead.data.lang}
                  class="mt-2 text-sm text-text-secondary leading-relaxed max-w-[62ch]"
                >
                  {lead.data.description}
                </p>

                <!-- The heading above is plain text for paired entries, so these chips are the
                     only links to the piece; "EN" alone is not an accessible name. -->
                {versions.length > 1 && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {versions.map((v) => (
                      <a
                        href={hrefOf(v)}
                        target={isExternal(v) ? '_blank' : undefined}
                        rel={isExternal(v) ? 'noopener noreferrer' : undefined}
                        aria-label={`${v.data.title} (${v.data.lang.toUpperCase()})`}
                        class="inline-flex items-center gap-2 rounded-lg border border-border px-2.5 py-1.5 text-xs text-text-secondary hover:border-accent/60 hover:text-accent transition-colors"
                      >
                        <span class="font-mono uppercase text-[10px] text-accent">{v.data.lang}</span>
                        {v.data.read_time && <span class="text-text-muted">{v.data.read_time}</span>}
                        {isExternal(v) && <span aria-hidden="true">&#8599;</span>}
                      </a>
                    ))}
                  </div>
                )}

                {lead.data.related_project && projectTitles.has(lead.data.related_project) && (
                  <a
                    href={`/projects/${lead.data.related_project}`}
                    class="inline-block mt-3 text-xs text-accent hover:underline"
                  >
                    Shipped alongside: {projectTitles.get(lead.data.related_project)} &rarr;
                  </a>
                )}
              </li>
            ))}
          </ul>

          <a href="/writing" class="inline-block mt-5 text-sm text-accent hover:underline">
            All writing &rarr;
          </a>

          <p class="mt-9 font-mono text-xs text-text-muted">
            <span aria-hidden="true">&#8634;</span>
            &nbsp;and the answers come back as the next question
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- ── Teaching ─────────────────────────────────────────────── -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <h2 class="text-2xl md:text-3xl font-bold text-text-primary">In front of a room</h2>
      <p class="mt-3 text-text-secondary leading-relaxed max-w-[64ch]">
        A channel scales answers. A room scales the moment someone decides the thing is learnable at
        all. Affiliation is listed per item because these were not all the same job.
      </p>

      <!-- A ledger, not cards: three entries that differ in kind read better as rows
           with a shared spine than as three boxes pretending to be siblings. -->
      <dl class="mt-10 border-t border-border">
        {lecture && (
          <div class="grid md:grid-cols-[9rem_1fr] gap-x-8 gap-y-2 py-6 border-b border-border">
            <dt class="font-mono text-[11px] text-text-muted md:pt-1.5">
              2023 <span class="text-text-secondary">· Onther</span>
            </dt>
            <dd>
              <a href={`/projects/${lecture.id}`} class="group">
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
                  Korea University &times; Onther — smart contract lecture series
                </h3>
              </a>
              <p class="mt-2 text-sm text-text-secondary leading-relaxed max-w-[62ch]">
                A semester of curriculum, sequenced so security comes last — students meet the
                vulnerability catalog only once they can place it. Course materials published for
                reference after the course ended.
              </p>
            </dd>
          </div>
        )}
        {ctf && (
          <div class="grid md:grid-cols-[9rem_1fr] gap-x-8 gap-y-2 py-6 border-b border-border">
            <dt class="font-mono text-[11px] text-text-muted md:pt-1.5">
              2024 <span class="text-text-secondary">· with Graylab</span>
            </dt>
            <dd>
              <a href={`/projects/${ctf.id}`} class="group">
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
                  EthCon Korea 2024 — security CTF
                </h3>
              </a>
              <p class="mt-2 text-sm text-text-secondary leading-relaxed max-w-[62ch]">
                Authored the challenge set across contract exploitation, cryptography and bytecode
                reversing on a beginner-to-advanced ladder, ran the scoring platform live, and
                supported players on the floor for the length of the conference.
              </p>
            </dd>
          </div>
        )}
        {localization && (
          <div class="grid md:grid-cols-[9rem_1fr] gap-x-8 gap-y-2 py-6 border-b border-border">
            <dt class="font-mono text-[11px] text-text-muted md:pt-1.5">
              2026 <span class="text-text-secondary">· independent</span>
            </dt>
            <dd>
              <a href={`/projects/${localization.id}`} class="group">
                <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
                  {localization.data.title}
                </h3>
              </a>
              <p class="mt-2 text-sm text-text-secondary leading-relaxed max-w-[62ch]">
                The same instinct pointed at someone else's docs: 13 courses and 388 lessons brought
                into Korean, with the English source kept beside each translation so the result can
                be audited rather than trusted.
              </p>
            </dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  <!-- ── What it's backed by ──────────────────────────────────── -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <h2 class="text-2xl md:text-3xl font-bold text-text-primary">Built it, then documented it</h2>
      <p class="mt-3 text-text-secondary leading-relaxed max-w-[64ch]">
        "How much on-chain authority should an AI agent have, and how do you bound it?" — the
        question I'm building against right now. A reference implementation is a claim; the docs
        that ship with it are the part a builder actually meets first, so I write those too.
      </p>

      {flagship && (
        <a
          href={`/projects/${flagship.id}`}
          class="lift group mt-10 block rounded-2xl border border-accent/25 bg-card p-6 md:p-9 hover:border-accent/60"
        >
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-2xl md:text-3xl font-bold text-text-primary group-hover:text-accent transition-colors">
              {flagship.data.title}
            </h3>
            <time
              datetime={iso(flagship.data.date)}
              class="font-mono text-[11px] text-text-muted whitespace-nowrap"
            >
              {fmt(flagship.data.date)}
            </time>
          </div>
          <p class="mt-4 text-text-secondary leading-relaxed max-w-[62ch]">
            {flagship.data.description}
          </p>
          <div class="mt-6 flex flex-wrap gap-x-3 gap-y-2 font-mono text-[11px] text-text-muted">
            {flagship.data.tech_stack.slice(0, 8).map((t) => <span>{t}</span>)}
          </div>
        </a>
      )}

      <!-- Outside the card above, because that card is a link and these are links:
           an anchor cannot legally nest inside another anchor. -->
      {flagship && (
        <ul class="mt-4 grid sm:grid-cols-2 gap-3">
          {FLAGSHIP_LINKS.map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="lift group flex items-baseline justify-between gap-4 rounded-xl border border-border bg-secondary/40 px-5 py-4 hover:border-accent/60"
              >
                <span class="font-mono text-sm text-text-primary group-hover:text-accent transition-colors">
                  {l.label} <span aria-hidden="true">&#8599;</span>
                </span>
                <span class="text-[11px] text-text-muted text-right">{l.note}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-4 grid sm:grid-cols-2 gap-4">
        {supporting.map((p) => (
          <a
            href={`/projects/${p.id}`}
            class="lift group block rounded-2xl border border-border bg-card p-5 md:p-6 hover:border-accent/60"
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
                {p.data.title}
              </h3>
              <time
                datetime={iso(p.data.date)}
                class="font-mono text-[11px] text-text-muted whitespace-nowrap"
              >
                {fmt(p.data.date)}
              </time>
            </div>
            <p class="mt-2.5 text-sm text-text-secondary leading-relaxed">{p.data.description}</p>
            <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5 font-mono text-[11px] text-text-muted">
              {p.data.tech_stack.slice(0, 4).map((t) => <span>{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Contact ──────────────────────────────────────────────── -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary">Let's talk</h2>
          <p class="mt-3 text-text-secondary leading-relaxed max-w-[52ch]">
            Always open to conversations about developer docs, reference implementations, and
            bilingual technical content.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href={`mailto:${SITE.email}`}
            class="px-5 py-2.5 bg-accent-strong text-white rounded-lg text-sm font-medium hover:bg-[#1d4ed8] transition-colors"
          >
            {SITE.email}
          </a>
          <a
            href={TELEGRAM.url}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 bg-card border border-border text-text-primary rounded-lg text-sm font-medium hover:border-accent/60 transition-colors"
          >
            Telegram
          </a>
          <a
            href="https://github.com/kooroot"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 bg-card border border-border text-text-primary rounded-lg text-sm font-medium hover:border-accent/60 transition-colors"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-title {
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* A single page-load orchestration on the masthead. Deliberately not repeated
     per section — and driven by CSS rather than an observer class, so the content
     is present even when the animation never runs. */
  .rise {
